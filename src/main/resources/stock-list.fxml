<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controller.StockListController"
            prefHeight="600" prefWidth="800"
            style="-fx-background-color: white; -fx-padding: 20;">

    <!-- Page Title -->
    <Label text="📦 Current Stock"
           layoutX="30" layoutY="10"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <!-- Card-style container -->
    <AnchorPane layoutX="30" layoutY="50" prefHeight="520" prefWidth="740"
                style="-fx-background-color: #ffffff;
                       -fx-background-radius: 12;
                       -fx-border-radius: 12;
                       -fx-border-color: #dcdcdc;
                       -fx-border-width: 1.5;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0.3, 0, 2);">

        <!-- Table with better visuals -->
        <TableView fx:id="stockTable"
                   layoutX="15" layoutY="15"
                   prefHeight="490" prefWidth="710"
                   style="-fx-font-size: 16px;
                          -fx-background-color: white;
                          -fx-table-cell-border-color: #e8e8e8;
                          -fx-border-color: transparent;
                          -fx-padding: 12;
                          -fx-selection-bar: #e3f2fd;
                          -fx-selection-bar-text: #0d47a1;">

            <columns>
                <TableColumn fx:id="productIdColumn" text="Product ID" prefWidth="120"
                             style="-fx-font-weight: bold; -fx-alignment: CENTER_LEFT;" />
                <TableColumn fx:id="productNameColumn" text="Product Name" prefWidth="250"
                             style="-fx-font-weight: bold; -fx-alignment: CENTER_LEFT;" />
                <TableColumn fx:id="stockCountColumn" text="Quantity" prefWidth="100"
                             style="-fx-font-weight: bold; -fx-alignment: CENTER;" />
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="100"
                             style="-fx-font-weight: bold; -fx-alignment: CENTER;" />
                <TableColumn fx:id="timestampColumn" text="Date" prefWidth="140"
                             style="-fx-font-weight: bold; -fx-alignment: CENTER;" />
            </columns>
        </TableView>
    </AnchorPane>
</AnchorPane>
