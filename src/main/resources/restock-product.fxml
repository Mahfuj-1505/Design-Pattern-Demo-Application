<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controller.RestockProductController"
            prefWidth="650" prefHeight="520"
            style="-fx-background-color: white; -fx-padding: 20;">

    <!-- Card-style container -->
    <AnchorPane layoutX="100" layoutY="70" prefWidth="450" prefHeight="360"
                style="-fx-background-color: #fdfdfd;
                       -fx-border-radius: 12;
                       -fx-background-radius: 12;
                       -fx-border-color: #dcdcdc;
                       -fx-border-width: 1.5;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0.3, 0, 2);">

        <VBox spacing="14" layoutX="30" layoutY="30" prefWidth="390">

            <Label text="Restock Product"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" />

            <Label text="Select Product" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
            <ComboBox fx:id="productComboBox" editable="true" promptText="Type product name"
                      prefWidth="300"
                      style="-fx-background-color: #f1f3f5;
                             -fx-background-radius: 10;
                             -fx-border-radius: 10;
                             -fx-border-color: #ced4da;
                             -fx-font-size: 13px;
                             -fx-padding: 6 10;" />

            <Label fx:id="availableLabel" text="Available: -" textFill="#6c757d"
                   style="-fx-font-size: 12px; -fx-padding: 2 0 0 4;" />

            <Label text="Restock Quantity" style="-fx-font-size: 13px; -fx-text-fill: #495057;" />
            <TextField fx:id="restockQuantityField" promptText="Enter quantity"
                       style="-fx-background-color: #f1f3f5;
                              -fx-background-radius: 10;
                              -fx-border-radius: 10;
                              -fx-border-color: #ced4da;
                              -fx-font-size: 13px;
                              -fx-padding: 8 12;" />

            <Button fx:id="restockButton" text="Restock"
                    style="-fx-background-color: #007bff;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 20;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0.3, 0, 2);"
                            onMouseEntered="#hoverGlow" onMouseExited="#removeGlow"
            />

            <Label fx:id="statusLabel"
                   style="-fx-font-size: 13px; -fx-text-fill: green; -fx-padding: 5 0 0 0;" />
        </VBox>
    </AnchorPane>
</AnchorPane>
