<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="800" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.StockListController">

    <!-- Page Title -->
    <Label layoutX="30" layoutY="10" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📦 Current Stock" />

    <!-- Card-style container -->
    <AnchorPane layoutX="30" layoutY="50" prefHeight="520" prefWidth="740" style="-fx-background-color: #ffffff;                        -fx-background-radius: 12;                        -fx-border-radius: 12;                        -fx-border-color: #dcdcdc;                        -fx-border-width: 1.5;                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0.3, 0, 2);">

        <!-- Table with better visuals -->
        <TableView fx:id="stockTable" layoutX="10" layoutY="10" prefHeight="506.0" prefWidth="724.0" style="-fx-background-color: white;                   -fx-table-cell-border-color: #f0f0f0;                   -fx-font-size: 14px;                   -fx-text-fill: #333;                   -fx-padding: 10;">

            <columns>
                <TableColumn fx:id="productIdColumn" prefWidth="100" text="Product ID" />
                <TableColumn fx:id="productNameColumn" prefWidth="200" text="Product Name" />
                <TableColumn fx:id="stockCountColumn" prefWidth="100" text="Quantity" />
                <TableColumn fx:id="typeColumn" prefWidth="100" text="Type" />
                <TableColumn fx:id="timestampColumn" prefWidth="180" text="Date" /> <!-- Increased from 130 -->
            </columns>
        </TableView>

    </AnchorPane>
</AnchorPane>
