<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controller.OrderListController"
            prefHeight="520" prefWidth="650"
            style="-fx-background-color: white; -fx-padding: 20;">

    <Label text="📄 Order List"
           layoutX="30" layoutY="10"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <AnchorPane layoutX="30" layoutY="50" prefHeight="440" prefWidth="590"
                style="-fx-background-color: #fdfdfd;
                       -fx-background-radius: 10;
                       -fx-border-radius: 10;
                       -fx-border-color: #e0e0e0;
                       -fx-border-width: 1.5;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0.3, 0, 2);">

        <TableView fx:id="orderTable" layoutX="10" layoutY="10"
                   prefHeight="390" prefWidth="570"
                   style="-fx-font-size: 16px;
                          -fx-background-color: white;
                          -fx-table-cell-border-color: #e8e8e8;
                          -fx-selection-bar: #e3f2fd;
                          -fx-selection-bar-text: #0d47a1;">

            <columns>
                <TableColumn fx:id="idColumn" text="Order ID" prefWidth="100"
                             style="-fx-font-weight: bold; -fx-alignment: CENTER_LEFT;" />
                <TableColumn fx:id="customerIdColumn" text="Customer ID" prefWidth="100"
                             style="-fx-font-weight: bold; -fx-alignment: CENTER;" />
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="180"
                             style="-fx-font-weight: bold; -fx-alignment: CENTER;" />
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"
                             style="-fx-font-weight: bold; -fx-alignment: CENTER;" />
            </columns>
        </TableView>

        <Label fx:id="messageLabel" layoutX="10" layoutY="410"
               prefWidth="570"
               style="-fx-text-fill: #dc3545; -fx-font-size: 14px; -fx-font-weight: bold;" />
    </AnchorPane>
</AnchorPane>
