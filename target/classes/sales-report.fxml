<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controller.SalesReportController"
            prefWidth="600.0" prefHeight="400.0">

    <VBox spacing="15.0" alignment="CENTER" layoutX="50" layoutY="50" prefWidth="500" prefHeight="300">
        <Label text="Sales Report Page" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <!-- Report Type Selection -->
        <HBox spacing="10" alignment="CENTER">
            <Label text="Select Report Type:"/>
            <ChoiceBox fx:id="reportTypeChoice" prefWidth="150.0"/>
        </HBox>

        <!-- Action Selection -->
        <HBox spacing="10" alignment="CENTER">
            <Label text="Select Action:"/>
            <ChoiceBox fx:id="actionChoice" prefWidth="150.0"/>
        </HBox>

        <!-- Format Selection -->
        <HBox spacing="10" alignment="CENTER">
            <Label text="Select Format:"/>
            <ChoiceBox fx:id="formatChoice" prefWidth="150.0"/>
        </HBox>

        <Button text="Generate Report" onAction="#handleGenerateReport"/>

        <!-- Output -->
        <Label fx:id="outputLabel" style="-fx-text-fill: green; -fx-font-size: 14px;"/>
    </VBox>

</AnchorPane>
