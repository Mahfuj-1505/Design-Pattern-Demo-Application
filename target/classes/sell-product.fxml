<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="750" prefWidth="1200" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.SellProductController">

    <HBox spacing="40" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">

        <!-- Form Section -->
        <VBox prefWidth="420" spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0.3, 0, 2);">

            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Sell Product" />

            <!-- Product Selection -->
            <Label style="-fx-font-size: 14px; -fx-text-fill: #495057;" text="Select Product:" />
            <ComboBox fx:id="productComboBox" prefHeight="38" prefWidth="412.0" promptText="Type product name" styleClass="input-combo" />

            <Label fx:id="availableQtyLabel" style="-fx-font-size: 13px; -fx-text-fill: #6c757d;" text="Available: -" />

            <!-- Quantity -->
            <Label style="-fx-font-size: 14px; -fx-text-fill: #495057;" text="Quantity:" />
            <TextField fx:id="quantityField" prefHeight="38.0" prefWidth="377.0" promptText="Enter quantity" styleClass="input-field" />

            <!-- Price Per Unit -->
            <Label style="-fx-font-size: 14px; -fx-text-fill: #495057;" text="Price per Unit:" />
            <TextField fx:id="priceField" editable="false" styleClass="input-field" />

            <!-- Total Price -->
            <Label style="-fx-font-size: 14px; -fx-text-fill: #495057;" text="Total Price:" />
            <TextField fx:id="totalField" editable="false" styleClass="input-field" />

            <!-- Add to Order -->
            <Button fx:id="addToOrderButton" prefHeight="45" prefWidth="383.0" style="-fx-background-color: #007bff;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 20;                            -fx-font-size: 14px;                            -fx-cursor: hand;" text="Add to Order" />

            <Separator />

            <!-- Customer Info -->
            <Label style="-fx-font-size: 14px; -fx-text-fill: #495057;" text="Customer Phone:" />
            <ComboBox fx:id="phoneField" editable="true" prefHeight="43.0" prefWidth="381.0" promptText="Start typing phone..." styleClass="input-combo" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #495057;" text="Customer Name:" />
            <TextField fx:id="customerNameField" prefHeight="41.0" prefWidth="384.0" promptText="Auto-filled if exists" styleClass="input-field" />

            <!-- Sell Button -->
            <Button fx:id="sellButton" prefHeight="45" prefWidth="391.0" style="-fx-background-color: #28a745;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 20;                            -fx-font-size: 14px;                            -fx-cursor: hand;" text="Sell" />
        </VBox>

        <!-- Table Section -->
        <VBox prefWidth="700" spacing="15">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Order Summary" />
            <TableView fx:id="orderTable" prefHeight="1000.0" prefWidth="1000.0" style="-fx-background-color: white;                               -fx-border-color: #dee2e6;                               -fx-border-radius: 8;                               -fx-background-radius: 8;                               -fx-padding: 5;">
                <columns>
                    <TableColumn fx:id="colProduct" prefWidth="200" text="Product" />
                    <TableColumn fx:id="colQuantity" prefWidth="100" text="Qty" />
                    <TableColumn fx:id="colPrice" prefWidth="120" text="Price" />
                    <TableColumn fx:id="colTotal" prefWidth="150" text="Total" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</AnchorPane>
